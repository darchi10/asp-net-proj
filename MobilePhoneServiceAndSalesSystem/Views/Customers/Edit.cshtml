@model MobilePhoneServiceAndSalesSystem.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="container mt-4 mb-5 mx-auto" style="max-width: 800px;">
    <div class="card bg-dark text-light border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-gradient-dark border-bottom border-secondary p-4 p-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-pencil-square fs-2"></i>
                </div>
                <div>
                    <h2 class="mb-1 fw-bold">Update Profile</h2>
                    <p class="text-secondary mb-0">Modify contact details for Customer #@Model.Id</p>
                </div>
            </div>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" asp-route-id="@Model.Id">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-light rounded-3 mb-4"></div>
                <input asp-for="Id" type="hidden" />

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-person-badge me-2"></i>Personal Details</h5>
                <div class="row g-3 mb-4 border-bottom border-secondary pb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="FirstName" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="FirstName" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="LastName" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="LastName" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-telephone me-2"></i>Contact Information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Email" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " type="email" />
                            <label asp-for="Email" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="PhoneNumber" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="PhoneNumber" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Address" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="Address" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Address" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-5 pt-4 border-top border-secondary">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-save-fill me-2 fs-5"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-5 py-2 fw-bold d-flex align-items-center justify-content-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .focus-ring-primary:focus {
        background-color: #0a0a0c !important;
        border-color: var(--bs-primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important; /* Bootstrap primary blue tint */
        color: white !important;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: var(--bs-primary) !important;
        opacity: 0.9;
        font-weight: 500;
    }
    .form-floating > label::after {
        background-color: transparent !important;
    }
    .form-floating > .form-control {
        border-radius: 0.75rem;
    }
    .bg-gradient-dark {
        background: linear-gradient(145deg, #1a1a20, #121215);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
