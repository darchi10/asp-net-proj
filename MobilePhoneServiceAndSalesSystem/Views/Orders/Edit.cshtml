@model MobilePhoneServiceAndSalesSystem.Models.Order
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq

@{
    ViewData["Title"] = "Edit Order";
    var productOptions = ViewBag.Products as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var orderItems = Model.OrderItems?.ToList() ?? new List<MobilePhoneServiceAndSalesSystem.Models.OrderItem>();
    var selectedCustomerText = ViewBag.SelectedCustomerText as string ?? string.Empty;
    var selectedCustomerId = Model?.CustomerId > 0 ? Model.CustomerId : (int?)null;
    if (!orderItems.Any())
    {
        orderItems.Add(new MobilePhoneServiceAndSalesSystem.Models.OrderItem { Quantity = 1 });
    }
}

<div class="container mt-4 mb-5 mx-auto" style="max-width: 900px;">
    <div class="card bg-dark text-light border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-gradient-dark border-bottom border-secondary p-4 p-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-pencil-square fs-2"></i>
                </div>
                <div>
                    <h2 class="mb-1 fw-bold">Update Order</h2>
                    <p class="text-secondary mb-0">Adjust order details and shipping info</p>
                </div>
            </div>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" asp-route-id="@Model.Id">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-light rounded-3 mb-4"></div>
                }
                <input asp-for="Id" type="hidden" />

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-person-badge me-2"></i>Customer</h5>
                <div class="row g-3 mb-4 border-bottom border-secondary pb-4">
                    <div class="col-12">
                        @await Html.PartialAsync("_AutocompleteDropdown", new MobilePhoneServiceAndSalesSystem.Models.AutocompleteSelectViewModel
                        {
                            InputName = "CustomerId",
                            SelectedId = selectedCustomerId,
                            SelectedText = selectedCustomerText,
                            Label = "Customer",
                            Placeholder = "Start typing a customer name",
                            EndpointUrl = Url.Content("~/customers/search"),
                            RequiredMessage = "Select a customer."
                        })
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-box-seam me-2"></i>Order Items</h5>
                <div class="border border-secondary rounded-4 p-3 mb-4 bg-black bg-opacity-25">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-secondary small">Update products and quantities. Total is calculated automatically.</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-add-item>
                            <i class="bi bi-plus-lg me-1"></i>Add Item
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-dark table-borderless align-middle mb-0" id="order-items-table">
                            <thead class="text-secondary small">
                                <tr>
                                    <th>Product</th>
                                    <th style="width: 140px;">Quantity</th>
                                    <th style="width: 60px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < orderItems.Count; i++)
                                {
                                    var item = orderItems[i];
                                    <tr>
                                        <td>
                                            <select name="OrderItems[@i].ProductId" class="form-select bg-black text-light border-secondary focus-ring-primary" required>
                                                <option value="">-- Select Product --</option>
                                                @foreach (var option in productOptions)
                                                {
                                                    if (option.Value == item.ProductId.ToString())
                                                    {
                                                        <option value="@option.Value" selected>@option.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@option.Value">@option.Text</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input name="OrderItems[@i].Quantity" class="form-control bg-black text-light border-secondary focus-ring-primary" type="number" min="1" step="1" value="@(item.Quantity == 0 ? 1 : item.Quantity)" required />
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle" data-remove-item>
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-receipt me-2"></i>Order Details</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control bg-black text-light border-secondary" value="@Model.OrderDate.ToString("yyyy-MM-dd")" placeholder=" " readonly />
                            <label class="text-secondary">Order Date</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control bg-black text-light border-secondary" value="@Model.TotalAmount.ToString("0.00")" placeholder=" " readonly />
                            <label class="text-secondary">Current Total (EUR)</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="ShippingAddress" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="ShippingAddress" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="ShippingAddress" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-5 pt-4 border-top border-secondary">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-save-fill me-2 fs-5"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-5 py-2 fw-bold d-flex align-items-center justify-content-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const tableBody = document.querySelector("#order-items-table tbody");
            const addButton = document.querySelector("[data-add-item]");
            const template = document.createElement("template");

            template.innerHTML = `
                <tr>
                    <td>
                        <select name="OrderItems[__index__].ProductId" class="form-select bg-black text-light border-secondary focus-ring-primary" required>
                            <option value="">-- Select Product --</option>
                            ${Array.from(document.querySelectorAll("#order-items-table tbody tr:first-child option")).slice(1)
                                .map(option => `<option value="${option.value}">${option.textContent}</option>`)
                                .join("")}
                        </select>
                    </td>
                    <td>
                        <input name="OrderItems[__index__].Quantity" class="form-control bg-black text-light border-secondary focus-ring-primary" type="number" min="1" step="1" value="1" required />
                    </td>
                    <td class="text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-circle" data-remove-item>
                            <i class="bi bi-x"></i>
                        </button>
                    </td>
                </tr>`;

            function addRow() {
                const index = tableBody.querySelectorAll("tr").length;
                const html = template.innerHTML.replaceAll("__index__", index.toString());
                const fragment = document.createElement("tbody");
                fragment.innerHTML = html;
                tableBody.appendChild(fragment.firstElementChild);
            }

            function removeRow(button) {
                const rows = tableBody.querySelectorAll("tr");
                if (rows.length <= 1) {
                    const firstRow = rows[0];
                    firstRow.querySelector("select").value = "";
                    firstRow.querySelector("input[type='number']").value = "1";
                    return;
                }

                button.closest("tr").remove();
            }

            addButton.addEventListener("click", addRow);
            tableBody.addEventListener("click", function (event) {
                const removeButton = event.target.closest("[data-remove-item]");
                if (removeButton) {
                    removeRow(removeButton);
                }
            });
        })();
    </script>
}

<style>
    .focus-ring-primary:focus {
        background-color: #0a0a0c !important;
        border-color: var(--bs-primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
        color: white !important;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select:focus ~ label,
    .form-floating > .form-select:not(:placeholder-shown) ~ label {
        color: var(--bs-primary) !important;
        opacity: 0.9;
        font-weight: 500;
    }
    .form-floating > label::after {
        background-color: transparent !important;
    }
    .form-floating > .form-control,
    .form-floating > .form-select {
        border-radius: 0.75rem;
    }
    .bg-gradient-dark {
        background: linear-gradient(145deg, #1a1a20, #121215);
    }
</style>
