@model MobilePhoneServiceAndSalesSystem.Models.Phone

@{
    ViewData["Title"] = "Register Phone";
    var selectedCustomerText = ViewBag.SelectedCustomerText as string ?? string.Empty;
    var selectedCustomerId = Model?.CustomerId > 0 ? Model.CustomerId : (int?)null;
}

<div class="container mt-4 mb-5 mx-auto" style="max-width: 900px;">
    <div class="card bg-dark text-light border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-gradient-dark border-bottom border-secondary p-4 p-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-phone fs-2"></i>
                </div>
                <div>
                    <h2 class="mb-1 fw-bold">Register Phone</h2>
                    <p class="text-secondary mb-0">Capture device details for service tracking</p>
                </div>
            </div>
        </div>
        <div class="card-body p-4 p-md-5">
            <!-- AI Assistant Panel -->
            <div class="alert alert-info bg-info bg-opacity-10 border-info rounded-4 mb-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-info fs-3">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-2 text-info">AI Phone Parser</h6>
                        <p class="small mb-3 text-light">Describe the phone in natural language, AI will extract the details.</p>
                        <div class="input-group mb-2">
                            <input type="text" id="ai-input" class="form-control bg-black text-light border-secondary" placeholder="e.g., Samsung S23 for customer ID 5, IMEI 123456789012345, 2023, Android 13" />
                            <button type="button" id="ai-parse-btn" class="btn btn-info">
                                <i class="bi bi-magic me-1"></i> Parse
                            </button>
                        </div>
                        <div id="ai-status" class="small"></div>
                    </div>
                </div>
            </div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-light rounded-3 mb-4"></div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-cpu me-2"></i>Device Details</h5>
                <div class="row g-3 mb-4 border-bottom border-secondary pb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Brand" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="Brand" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Brand" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Model" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="Model" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Model" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="IMEI" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="IMEI" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="IMEI" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input asp-for="YearOfManufacture" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " type="number" />
                            <label asp-for="YearOfManufacture" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="YearOfManufacture" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input asp-for="OperatingSystem" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="OperatingSystem" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="OperatingSystem" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-person-badge me-2"></i>Ownership</h5>
                <div class="row g-3">
                    <div class="col-12">
                        @await Html.PartialAsync("_AutocompleteDropdown", new MobilePhoneServiceAndSalesSystem.Models.AutocompleteSelectViewModel
                        {
                            InputName = "CustomerId",
                            SelectedId = selectedCustomerId,
                            SelectedText = selectedCustomerText,
                            Label = "Customer",
                            Placeholder = "Start typing a customer name",
                            EndpointUrl = Url.Content("~/customers/search"),
                            RequiredMessage = "Select a customer."
                        })
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-5 pt-4 border-top border-secondary">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-check-lg me-2 fs-5"></i> Register Device
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-5 py-2 fw-bold d-flex align-items-center justify-content-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('ai-parse-btn').addEventListener('click', async function() {
            const input = document.getElementById('ai-input').value.trim();
            const status = document.getElementById('ai-status');
            const btn = this;

            if (!input) {
                status.innerHTML = '<span class="text-warning">Please enter a description</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';
            status.innerHTML = '<span class="text-info">AI is parsing your input...</span>';

            try {
                const response = await fetch('/phones/ai-parse', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ input: input })
                });

                if (response.ok) {
                    const data = await response.json();
                    document.querySelector('[name="Brand"]').value = data.brand || '';
                    document.querySelector('[name="Model"]').value = data.model || '';
                    document.querySelector('[name="IMEI"]').value = data.imei || '';
                    document.querySelector('[name="YearOfManufacture"]').value = data.yearOfManufacture || '';
                    document.querySelector('[name="OperatingSystem"]').value = data.operatingSystem || '';
                    
                    // Popuni customer
                    if (data.customerId && data.customerText) {
                        document.querySelector('[name="CustomerId"]').value = data.customerId;
                        document.querySelector('.autocomplete-input').value = data.customerText;
                        const idNote = data.explicitId ? ' (ID: ' + data.explicitId + ')' : '';
                        status.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i> Form filled! Customer: ' + data.customerText + idNote + '</span>';
                    } else if (data.explicitId) {
                        status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> Customer ID ' + data.explicitId + ' not found in database</span>';
                    } else if (data.customerSearchTerm) {
                        document.querySelector('.autocomplete-input').value = data.customerSearchTerm;
                        status.innerHTML = '<span class="text-warning"><i class="bi bi-info-circle me-1"></i> Form filled! Customer "' + data.customerSearchTerm + '" not found - please select from dropdown</span>';
                    } else {
                        status.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i> Form filled! Select customer manually</span>';
                    }
                } else {
                    const error = await response.json();
                    status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> ' + (error.error || 'Failed to parse') + '</span>';
                }
            } catch (err) {
                status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> Network error</span>';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-magic me-1"></i> Parse';
            }
        });

        document.getElementById('ai-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('ai-parse-btn').click();
            }
        });
    </script>
}

<style>
    .focus-ring-primary:focus {
        background-color: #0a0a0c !important;
        border-color: var(--bs-primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
        color: white !important;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select:focus ~ label,
    .form-floating > .form-select:not(:placeholder-shown) ~ label {
        color: var(--bs-primary) !important;
        opacity: 0.9;
        font-weight: 500;
    }
    .form-floating > label::after {
        background-color: transparent !important;
    }
    .form-floating > .form-control,
    .form-floating > .form-select {
        border-radius: 0.75rem;
    }
    .bg-gradient-dark {
        background: linear-gradient(145deg, #1a1a20, #121215);
    }
</style>
