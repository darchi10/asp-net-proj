@model MobilePhoneServiceAndSalesSystem.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-4 mb-5 mx-auto" style="max-width: 900px;">
    <div class="card bg-dark text-light border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-gradient-dark border-bottom border-secondary p-4 p-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-bag-plus fs-2"></i>
                </div>
                <div>
                    <h2 class="mb-1 fw-bold">Add Product</h2>
                    <p class="text-secondary mb-0">Create a new item for your store inventory</p>
                </div>
            </div>
        </div>
        <div class="card-body p-4 p-md-5">
            <!-- AI Assistant Panel -->
            <div class="alert alert-info bg-info bg-opacity-10 border-info rounded-4 mb-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-info fs-3">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-2 text-info">AI Assistant</h6>
                        <p class="small mb-3 text-light">Describe the product in natural language, and AI will fill the form for you.</p>
                        <div class="input-group mb-2">
                            <input type="text" id="ai-input" class="form-control bg-black text-light border-secondary" placeholder="e.g., iPhone 14 Pro Max 256GB, price 1200 euro, 15 in stock" />
                            <button type="button" id="ai-parse-btn" class="btn btn-info">
                                <i class="bi bi-magic me-1"></i> Parse
                            </button>
                        </div>
                        <div id="ai-status" class="small"></div>
                    </div>
                </div>
            </div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-light rounded-3 mb-4"></div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-box-seam me-2"></i>Product Details</h5>
                <div class="row g-3 mb-4 border-bottom border-secondary pb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Name" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="Name" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="CurrentPrice" asp-format="{0:0.##}" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " type="number" step="0.01" />
                            <label asp-for="CurrentPrice" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="CurrentPrice" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea asp-for="Description" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " style="height: 120px"></textarea>
                            <label asp-for="Description" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-box-seam me-2"></i>Inventory</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="StockQuantity" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " type="number" step="1" min="0" />
                            <label asp-for="StockQuantity" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-5 pt-4 border-top border-secondary">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-check-lg me-2 fs-5"></i> Save Product
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-5 py-2 fw-bold d-flex align-items-center justify-content-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('ai-parse-btn').addEventListener('click', async function() {
            const input = document.getElementById('ai-input').value.trim();
            const status = document.getElementById('ai-status');
            const btn = this;

            if (!input) {
                status.innerHTML = '<span class="text-warning">Please enter a description</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';
            status.innerHTML = '<span class="text-info">AI is parsing your input...</span>';

            try {
                const response = await fetch('/products/ai-parse', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ input: input })
                });

                if (response.ok) {
                    const data = await response.json();
                    document.querySelector('[name="Name"]').value = data.name || '';
                    document.querySelector('[name="Description"]').value = data.description || '';
                    document.querySelector('[name="CurrentPrice"]').value = data.currentPrice || '';
                    document.querySelector('[name="StockQuantity"]').value = data.stockQuantity || '';
                    status.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i> Form filled successfully!</span>';
                } else {
                    const error = await response.json();
                    status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> ' + (error.error || 'Failed to parse') + '</span>';
                }
            } catch (err) {
                status.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i> Network error</span>';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-magic me-1"></i> Parse';
            }
        });

        document.getElementById('ai-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('ai-parse-btn').click();
            }
        });
    </script>
}

<style>
    .focus-ring-primary:focus {
        background-color: #0a0a0c !important;
        border-color: var(--bs-primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
        color: white !important;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select:focus ~ label,
    .form-floating > .form-select:not(:placeholder-shown) ~ label {
        color: var(--bs-primary) !important;
        opacity: 0.9;
        font-weight: 500;
    }
    .form-floating > label::after {
        background-color: transparent !important;
    }
    .form-floating > .form-control,
    .form-floating > .form-select {
        border-radius: 0.75rem;
    }
    .bg-gradient-dark {
        background: linear-gradient(145deg, #1a1a20, #121215);
    }
</style>
