@model MobilePhoneServiceAndSalesSystem.Models.RepairJob

@{
    ViewData["Title"] = "New Repair Job";
}

<div class="container mt-4 mb-5 mx-auto" style="max-width: 950px;">
    <div class="card bg-dark text-light border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-gradient-dark border-bottom border-secondary p-4 p-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-tools fs-2"></i>
                </div>
                <div>
                    <h2 class="mb-1 fw-bold">Create Repair Job</h2>
                    <p class="text-secondary mb-0">Register a device service request</p>
                </div>
            </div>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-light rounded-3 mb-4"></div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-phone me-2"></i>Device</h5>
                <div class="row g-3 mb-4 border-bottom border-secondary pb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="PhoneId" asp-items="ViewBag.PhoneId" class="form-select bg-black text-light border-secondary focus-ring-primary">
                                <option value="">-- Select Device --</option>
                            </select>
                            <label asp-for="PhoneId" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="PhoneId" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="TechnicianId" asp-items="ViewBag.TechnicianId" class="form-select bg-black text-light border-secondary focus-ring-primary">
                                <option value="">-- Select Technician --</option>
                            </select>
                            <label asp-for="TechnicianId" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="TechnicianId" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-clipboard-check me-2"></i>Job Details</h5>
                <div class="row g-3 mb-4 border-bottom border-secondary pb-4">
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea asp-for="Description" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " style="height: 140px"></textarea>
                            <label asp-for="Description" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <select asp-for="Status" class="form-select bg-black text-light border-secondary focus-ring-primary" asp-items="Html.GetEnumSelectList<MobilePhoneServiceAndSalesSystem.Models.Enums.RepairStatus>()"></select>
                            <label asp-for="Status" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-4">
                        @await Html.PartialAsync("_DateTimePicker", new MobilePhoneServiceAndSalesSystem.Models.DateTimePickerViewModel
                        {
                            PropertyName = "ReceivedDate",
                            Label = "Received Date",
                            Value = Model?.ReceivedDate ?? System.DateTime.Now,
                            IncludeTime = true
                        })
                    </div>
                    <div class="col-md-4">
                        @await Html.PartialAsync("_DateTimePicker", new MobilePhoneServiceAndSalesSystem.Models.DateTimePickerViewModel
                        {
                            PropertyName = "CompletedDate",
                            Label = "Completed Date",
                            Value = Model?.CompletedDate,
                            IncludeTime = true
                        })
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="LaborCost" asp-format="{0:0.##}" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " type="number" step="0.01" />
                            <label asp-for="LaborCost" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="LaborCost" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-cpu me-2"></i>Used Parts</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <select name="usedPartIds" multiple class="form-select bg-black text-light border-secondary focus-ring-primary" size="6" asp-items="ViewBag.UsedPartIds"></select>
                        <div class="form-text text-secondary mt-2">Hold Ctrl (Windows) or Cmd (Mac) to select multiple parts.</div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-5 pt-4 border-top border-secondary">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-check-lg me-2 fs-5"></i> Save Repair Job
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-5 py-2 fw-bold d-flex align-items-center justify-content-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .focus-ring-primary:focus {
        background-color: #0a0a0c !important;
        border-color: var(--bs-primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
        color: white !important;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select:focus ~ label,
    .form-floating > .form-select:not(:placeholder-shown) ~ label {
        color: var(--bs-primary) !important;
        opacity: 0.9;
        font-weight: 500;
    }
    .form-floating > label::after {
        background-color: transparent !important;
    }
    .form-floating > .form-control,
    .form-floating > .form-select {
        border-radius: 0.75rem;
    }
    .bg-gradient-dark {
        background: linear-gradient(145deg, #1a1a20, #121215);
    }
</style>
