<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MobilePhoneServiceAndSalesSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MobilePhoneServiceAndSalesSystem.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isSignedIn = User.Identity?.IsAuthenticated == true;
        var isAdmin = User.IsInRole("Admin");
        var isWorker = User.IsInRole("Worker");
        var isCustomer = User.IsInRole("Customer");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" href="~/">
                    <span class="text-primary">Mobi</span>Service
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 @(currentController == "Home" ? "active fw-semibold" : string.Empty)" href="~/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(currentController == "Products" ? "active fw-semibold" : string.Empty)" href="~/products">Store</a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 @(currentController == "Customers" ? "active fw-semibold" : string.Empty)" href="~/customers">Customers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 @(currentController == "Phones" ? "active fw-semibold" : string.Empty)" href="~/phones">Phones</a>
                            </li>
                        }
                        @if (isAdmin || isWorker || isCustomer)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 @(currentController == "RepairJobs" && currentAction != "Tracker" ? "active fw-semibold" : string.Empty)" href="~/repair-jobs">Repairs</a>
                            </li>
                        }
                        @if (isAdmin || isWorker)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 @(currentController == "SpareParts" ? "active fw-semibold" : string.Empty)" href="~/spare-parts">Spare Parts</a>
                            </li>
                        }
                        @if (isAdmin || isCustomer)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 @(currentController == "Orders" ? "active fw-semibold" : string.Empty)" href="~/orders">Orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 fw-medium @(currentController == "RepairJobs" && currentAction == "Tracker" ? "active fw-bold text-primary" : "text-warning")" href="~/repair-jobs/tracker">Track Repair</a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 @(currentController == "Technicians" ? "active fw-semibold" : string.Empty)" href="~/technicians">Technicians</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span>&copy; 2026 - MobilePhoneServiceAndSalesSystem</span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/hr.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
