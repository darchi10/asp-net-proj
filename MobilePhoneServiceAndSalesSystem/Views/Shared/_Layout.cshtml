<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content="Mobile Phone Service and Sales System - Comprehensive repair tracking and product management" />
    <meta name="theme-color" content="#1c1f26" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>@ViewData["Title"] - MobilePhoneServiceAndSalesSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global-search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MobilePhoneServiceAndSalesSystem.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isSignedIn = User.Identity?.IsAuthenticated == true;
        var isAdmin = User.IsInRole("Admin");
        var isWorker = User.IsInRole("Worker");
        var isCustomer = User.IsInRole("Customer");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" href="~/">
                    <span class="text-primary">Mobi</span>Service
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 @(currentController == "Home" ? "active fw-semibold" : string.Empty)" href="~/"><i class="bi bi-house me-2"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(currentController == "Products" ? "active fw-semibold" : string.Empty)" href="~/products"><i class="bi bi-shop me-2"></i>Store</a>
                        </li>
                        @if (isAdmin || isWorker || isCustomer)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 @(currentController == "RepairJobs" && currentAction != "Tracker" ? "active fw-semibold" : string.Empty)" href="~/repair-jobs"><i class="bi bi-tools me-2"></i>Repairs</a>
                            </li>
                        }
                        @if (isCustomer && !isAdmin && !isWorker)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 @(currentController == "Orders" ? "active fw-semibold" : string.Empty)" href="~/orders"><i class="bi bi-cart me-2"></i>Orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 fw-medium @(currentController == "RepairJobs" && currentAction == "Tracker" ? "active fw-bold text-primary" : "text-warning")" href="~/repair-jobs/tracker"><i class="bi bi-search me-2"></i>Track Repair</a>
                            </li>
                        }
                        @if (isAdmin || isWorker)
                        {
                            var isManagementActive = currentController == "Customers" || currentController == "Phones" || currentController == "SpareParts" || currentController == "Technicians" || currentController == "Orders" || (currentController == "RepairJobs" && currentAction == "Tracker");
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-3 @(isManagementActive ? "active fw-semibold" : string.Empty)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Management
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    @if (isAdmin)
                                    {
                                        <li><a class="dropdown-item @(currentController == "Customers" ? "active" : string.Empty)" href="~/customers"><i class="bi bi-people me-2"></i>Customers</a></li>
                                        <li><a class="dropdown-item @(currentController == "Phones" ? "active" : string.Empty)" href="~/phones"><i class="bi bi-phone me-2"></i>Phones</a></li>
                                    }
                                    @if (isAdmin || isWorker)
                                    {
                                        <li><a class="dropdown-item @(currentController == "SpareParts" ? "active" : string.Empty)" href="~/spare-parts"><i class="bi bi-gear me-2"></i>Spare Parts</a></li>
                                    }
                                    @if (isAdmin || isCustomer)
                                    {
                                        <li><a class="dropdown-item @(currentController == "Orders" ? "active" : string.Empty)" href="~/orders"><i class="bi bi-cart me-2"></i>Orders</a></li>
                                        <li><a class="dropdown-item @(currentController == "RepairJobs" && currentAction == "Tracker" ? "active" : string.Empty)" href="~/repair-jobs/tracker"><i class="bi bi-search me-2"></i>Track Repair</a></li>
                                    }
                                    @if (isAdmin)
                                    {
                                        <li><a class="dropdown-item @(currentController == "Technicians" ? "active" : string.Empty)" href="~/technicians"><i class="bi bi-person-badge me-2"></i>Technicians</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    <button class="btn btn-outline-light me-3 d-flex align-items-center gap-2 px-3 py-1.5 border-1 rounded-pill" id="global-search-btn" title="Search (Ctrl+K)" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15);">
                        <i class="bi bi-search"></i>
                        <span class="d-none d-lg-inline fs-7 opacity-75">Search...</span>
                        <kbd class="d-none d-lg-inline bg-dark text-white border-secondary opacity-50 px-1 py-0.5 rounded text-xs ms-1" style="font-size: 0.65rem; font-family: inherit;">Ctrl K</kbd>
                    </button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-3">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span class="text-center text-sm-start">&copy; 2026 - MobilePhoneServiceAndSalesSystem</span>
                <a href="~/home/privacy" class="text-decoration-none text-muted">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <!-- Global Search Modal -->
    <div class="modal fade" id="globalSearchModal" tabindex="-1" aria-labelledby="globalSearchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content global-search-content border-0">
                <div class="modal-header border-0 pb-0">
                    <div class="input-group global-search-input-group">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-secondary fs-5"></i></span>
                        <input type="text" class="form-control bg-transparent border-0 text-white fs-5" id="global-search-input" placeholder="Type to search menu, pages or database..." autocomplete="off">
                        <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body pt-2 px-3">
                    <div class="text-secondary px-3 py-1 mb-2 border-bottom border-secondary border-opacity-10 d-flex justify-content-between text-xs" style="font-size: 0.8rem;">
                        <span>Search Results</span>
                        <span class="d-none d-md-inline">Use ↑↓ and Enter to navigate</span>
                    </div>
                    <div class="global-search-results list-group list-group-flush" id="global-search-results">
                        <!-- Rezultati će se učitati ovdje -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/hr.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/global-search.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
