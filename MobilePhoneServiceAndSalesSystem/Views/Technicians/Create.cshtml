@model MobilePhoneServiceAndSalesSystem.Models.ViewModels.TechnicianCreateViewModel

@{
    ViewData["Title"] = "Create Technician";
}

<div class="container mt-4 mb-5 mx-auto" style="max-width: 800px;">
    <div class="card bg-dark text-light border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-gradient-dark border-bottom border-secondary p-4 p-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-person-plus fs-2"></i>
                </div>
                <div>
                    <h2 class="mb-1 fw-bold">Hire Technician</h2>
                    <p class="text-secondary mb-0">Add a new technician to your service team</p>
                </div>
            </div>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-light rounded-3 mb-4"></div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-person-badge me-2"></i>Profile</h5>
                <div class="row g-3 mb-4 border-bottom border-secondary pb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="FirstName" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="FirstName" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="LastName" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="LastName" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Specialization" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="Specialization" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Specialization" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-shield-lock me-2"></i>Account</h5>
                <div class="row g-3 mb-4 border-bottom border-secondary pb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Email" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="Email" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Password" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="Password" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ConfirmPassword" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " />
                            <label asp-for="ConfirmPassword" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <h5 class="text-primary mb-3 fs-6 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-clipboard-check me-2"></i>Employment</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        @await Html.PartialAsync("_DateTimePicker", new MobilePhoneServiceAndSalesSystem.Models.DateTimePickerViewModel
                        {
                            PropertyName = "HireDate",
                            Label = "Hire Date",
                            Value = Model?.HireDate ?? System.DateTime.Now,
                            IncludeTime = false
                        })
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Salary" asp-format="{0:0.##}" class="form-control bg-black text-light border-secondary focus-ring-primary" placeholder=" " type="number" step="0.01" />
                            <label asp-for="Salary" class="text-secondary"></label>
                        </div>
                        <span asp-validation-for="Salary" class="text-danger small mt-1 d-block ms-1"></span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-5 pt-4 border-top border-secondary">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-check-lg me-2 fs-5"></i> Add Technician
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-5 py-2 fw-bold d-flex align-items-center justify-content-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .focus-ring-primary:focus {
        background-color: #0a0a0c !important;
        border-color: var(--bs-primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
        color: white !important;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: var(--bs-primary) !important;
        opacity: 0.9;
        font-weight: 500;
    }
    .form-floating > label::after {
        background-color: transparent !important;
    }
    .form-floating > .form-control {
        border-radius: 0.75rem;
    }
    .bg-gradient-dark {
        background: linear-gradient(145deg, #1a1a20, #121215);
    }
</style>
